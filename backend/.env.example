# Copy this file to backend/.env (which is git-ignored) and fill in real values.
# Never commit backend/.env — it contains your database password.

# Neon PostgreSQL connection string: Neon dashboard > your project > Connect.
# Paste it exactly as shown (postgresql://...); the app adds the driver name itself.
# Leave it empty or delete the line to use the local SQLite file instead.
DATABASE_URL=

# Only needed in production; development generates one in instance/secret_key.
# SECRET_KEY=
